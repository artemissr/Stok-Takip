{
  "expo": {
    "name": "Kontrol Sende",
    "slug": "kontrolsende",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kontrolsende",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kontrolsende.app"
    },
    "android": {
      "package": "com.kontrolsende.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "Mutfak Stok Takibi",
      "shortName": "Mutfak Stok",
      "description": "Restoran ve kafeler için stok, SKT ve satış takibi",
      "themeColor": "#1f6b52",
      "backgroundColor": "#f6f3ed",
      "lang": "tr"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}